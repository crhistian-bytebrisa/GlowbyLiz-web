---
const IG_URL = 'https://www.instagram.com/glowbyliz.rd/';
const logoSrc = `${import.meta.env.BASE_URL}images/8.jpeg`;
---

<header class="site-header">
  <div class="container header-inner">
    <a href="#top" class="brand">
      <img src={logoSrc} alt="Glow by Liz RD" class="brand-logo" />
      <span class="brand-name">glowbyliz<span class="dot">.rd</span></span>
    </a>

    <nav class="nav" aria-label="Navegación principal">
      <a href="#productos">Productos</a>
      <a href="#nosotros">Nosotros</a>
      <a href="#pedidos">Cómo pedir</a>
    </nav>

    <a href={IG_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary header-cta">
      Instagram
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 246, 249, 0.88);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(200, 29, 75, 0.08);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 14px;
    padding-bottom: 14px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }

  .brand-logo {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 4px 10px -4px rgba(58, 10, 30, 0.4);
  }

  .brand-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--plum);
  }

  .dot {
    color: var(--cherry);
  }

  .nav {
    display: flex;
    gap: 28px;
    font-weight: 600;
    font-size: 0.95rem;
  }

  .nav a {
    text-decoration: none;
    color: var(--plum);
    position: relative;
    padding-bottom: 4px;
  }

  .nav a:hover {
    color: var(--cherry);
  }

  .header-cta {
    padding: 10px 22px;
    font-size: 0.92rem;
    white-space: nowrap;
  }

  @media (max-width: 780px) {
    .nav {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .brand-name {
      font-size: 1rem;
    }
    .header-cta {
      padding: 9px 16px;
      font-size: 0.82rem;
    }
  }
</style>
